/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spine",
  "account_id": "345590cd19a379d6bf1008c6a7860451",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-18",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "placement": { "mode": "smart" },
  "keep_vars": false,
  "routes": ["finasaan.com/api/*", "www.finasaan.com/api/*"],

  // preview environment
  "env": {
    "preview": {
      "name": "spine-preview",
      "routes": ["finasaan.com/api/preview/*", "www.finasaan.com/api/preview/*"]
    }
  },

  // dev configuration
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  }
}
